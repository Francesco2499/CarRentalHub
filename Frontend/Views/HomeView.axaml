<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Frontend.Views.HomeView"
             xmlns:vm="using:Frontend.ViewModels"
             x:DataType="vm:HomeViewModel"
             Background="Black">

    <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
        
        <TextBlock Text="Benvenuti su CarRentalHub" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="10"/>

        <Button Content="Login" Width="200" Height="40" Command="{Binding LoginCommand}"  Background="#007ACC" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>

        <Button Content="Registrati" Width="200" Height="40" Command="{Binding RegisterCommand}" Background="#28A745" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>

    </StackPanel>

</UserControl>
