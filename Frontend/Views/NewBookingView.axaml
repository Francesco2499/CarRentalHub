<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Frontend.ViewModels"
             xmlns:models="clr-namespace:Frontend.Models"
             mc:Ignorable="d" d:DesignWidth="768" d:DesignHeight="650"
             x:Class="Frontend.Views.NewBookingView"
             xmlns:converters="clr-namespace:Frontend.Converters"
             x:DataType="vm:NewBookingViewModel">
  
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Nuova Prenotazione" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

    <TextBlock IsVisible="{Binding IsVisibleSubTitle}" Text="Per effettuare una prenotazione, inizia selezionando le date in cui desideri noleggiare un'auto e il comune di ritiro. Una volta scelto il periodo e la località, ti mostreremo le auto disponibili. Potrai confrontare le opzioni, selezionare il veicolo più adatto alle tue esigenze e completare la prenotazione in pochi passaggi!" 
           Width="800" 
           FontSize="16"
           TextWrapping="Wrap"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center"
           TextAlignment="Justify" 
           Margin="0,0,0,20"/>

    <StackPanel IsVisible="{Binding IsVisibleSearchDate}">

      <TextBlock Text="Scegli la data e il comune per la tua prenotazione:" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20"/>
      
      <StackPanel Spacing="20" Margin="20" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <CalendarDatePicker SelectedDateFormat="Short" SelectedDate="{Binding StartDate}" Margin="40,0,80,0"/>
        <StackPanel Orientation="Horizontal">
                <CalendarDatePicker SelectedDateFormat="Short" SelectedDate="{Binding EndDate}" />
                
                <!-- Icona info con tooltip -->
                <PathIcon Data="{Binding Source=info_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" 
                          Width="20" Height="20" Margin="15,0,0,0">
                    <ToolTip.Tip>
                        <TextBlock Text="La prenotazione durerà fino alle 23:59 dell'ultimo giorno selezionato." Width="200" TextWrapping="Wrap"/>
                    </ToolTip.Tip>
                </PathIcon>
            </StackPanel>
      </StackPanel>

      <TextBox Watermark="Inserisci il comune"  Width="350" Margin="20" HorizontalAlignment="Center" Text="{Binding Location}" />

      <Button Content="See available vehicles"  Command="{Binding SearchVehiclesCommand}" HorizontalAlignment="Center" Margin="10"/>

      <TextBlock Text="{Binding FirstErrorMessage}" HorizontalAlignment="Center" Foreground="Red"/>

      <TextBlock Text="{Binding BookingMessage}" FontSize="20" TextAlignment="Center"/>

    </StackPanel>
    
    
    <!-- Bottone per la ricerca -->

    <StackPanel IsVisible="{Binding IsVisibleList}">
      
      <TextBox Watermark="Search vehicles..."  Width="350" Margin="20" HorizontalAlignment="Center" Text="{Binding SearchQuery}" />
      
      <StackPanel HorizontalAlignment="Center" Margin="20" Orientation="Horizontal">
          <Button Content="Search for model" Command="{Binding SearchItemsCommand}" CommandParameter="text" Margin="10"/>
          <Button Content="Show all" IsEnabled="{Binding EnableShowAll}" Command="{Binding SearchItemsCommand}" CommandParameter="all" Margin="10"/>
      </StackPanel>

      <Grid ColumnDefinitions="2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="650">
          <TextBlock Text="ID" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Model" Grid.Column="1"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Category" Grid.Column="2"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Price" Grid.Column="3"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
      </Grid>      
      <ListBox Padding="0"
              Width="650"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}">
          <ListBox.ItemTemplate>
              <DataTemplate>
                  <Grid ColumnDefinitions="2*, 2*, 2*, 2*">
                      <TextBlock Text="{Binding Id}" TextAlignment="Center"  Grid.Column="0" Margin="5"/>
                      <TextBlock Text="{Binding Model}" TextAlignment="Center"  Grid.Column="1" Margin="5"/>
                      <TextBlock Text="{Binding Category}" TextAlignment="Center"  Grid.Column="2" Margin="5"/>
                      <TextBlock Text="{Binding Price}" TextAlignment="Center"  Grid.Column="3" Margin="5"/>
                  </Grid>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding IsPaginationVisible}" HorizontalAlignment="Center" Orientation="Horizontal" Margin="10">
        <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
          <Button.Opacity>
              <Binding Path="PreviousPageOpacity" />
          </Button.Opacity>
          <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Height="10" Width="8"/>
        </Button>

        <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
          <Button.Opacity>
              <Binding Path="NextPageOpacity" />
          </Button.Opacity>
          <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Height="10" Width="8"/>
        </Button>
      </StackPanel>

      <StackPanel Margin="20" HorizontalAlignment="Center">
        <!-- Bottone per prenotare l'auto -->
        <StackPanel Margin="10, 20" Orientation="Horizontal" Spacing="30">
          <Button Content="Book car" Command="{Binding AddBookingCommand}" />
          <Button Content="Go back" Command="{Binding GoBackCommand}" />
        </StackPanel>
      </StackPanel> 

      <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" Foreground="Red" Margin="10"/>       

    </StackPanel>
    <StackPanel IsVisible="{Binding IsBookingSummaryVisible}" HorizontalAlignment="Center" Margin="20">
    
    <Border Background="#4e4e4e" CornerRadius="10" Padding="30" Width="400" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Booking Summary" FontSize="20" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>
            
            <Separator Background="Gray" Height="1" Margin="0,10"/>

                <TextBlock Text="{Binding Booking.vehicle_model, StringFormat='🚗 Vehicle: {0}'}" Margin="0,10"/>

                <TextBlock Text="{Binding Booking.start_date, StringFormat='📅 Start Date: {0:yyyy-MM-dd}'}" Margin="0,10"/>

                <TextBlock Text="{Binding Booking.end_date, StringFormat='📅 End Date: {0:yyyy-MM-dd}'}" Margin="0,10"/>

            <Separator Background="Gray" Height="1" Margin="0,10"/>
            
            <Button Content="Make another booking" Command="{Binding GoBackCommand}" HorizontalAlignment="Center" Margin="15" Padding="10,5"/>
        </StackPanel>
    </Border>

</StackPanel>

  </StackPanel>
</UserControl>
