<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Frontend.ViewModels"
             xmlns:models="clr-namespace:Frontend.Models"
             mc:Ignorable="d" d:DesignWidth="768" d:DesignHeight="450"
             x:Class="Frontend.Views.NewBookingView"
             xmlns:converters="clr-namespace:Frontend.Converters"
             x:DataType="vm:NewBookingViewModel">
  
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Nuova Prenotazione" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    <TextBlock Text="Qui puoi effettuare una nuova prenotazione, scegliendo prima la data di tuo interesse e successivamente selezionando l'auto che preferisci!" 
           Width="500" 
           TextWrapping="Wrap"
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Margin="0,0,0,20"/>


    <StackPanel IsVisible="{Binding IsVisibleSearchDate}">
      <TextBlock Text="Scegli la data per la tua prenotazione" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20"/>
          <StackPanel Spacing="17" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <CalendarDatePicker SelectedDateFormat="Short" SelectedDate="{Binding StartDate}" Margin="0,0,40,0"/>
            <CalendarDatePicker SelectedDateFormat="Short" SelectedDate="{Binding EndDate}" />
          </StackPanel>
      <TextBlock Text="{Binding DateSearchMessage}" Foreground="Red"/>

      <Button Content="Cerca"  Command="{Binding CercaVeicoliTestCommand}" HorizontalAlignment="Center"/>

    </StackPanel>
    
    
    <!-- Bottone per la ricerca -->

    <StackPanel IsVisible="{Binding IsVisibleList}">
      
      <TextBox Watermark="Cerca veicoli..."  Width="350" HorizontalAlignment="Center" Text="{Binding SearchQuery}" />

      <Button Content="Cerca auto" Margin="0 20 0 0" HorizontalAlignment="Center" Command="{Binding SearchItemsCommand}" CommandParameter="text"/>
    
      <Grid ColumnDefinitions="2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="600">
          <TextBlock Text="ID" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Modello" Grid.Column="1"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Categoria" Grid.Column="2"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          <TextBlock Text="Prezzo" Grid.Column="3"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
      </Grid>      
      <ListBox Padding="0"
              ItemsSource="{Binding Items}"
              SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}">
          <ListBox.Styles>
              <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="12 8" />
              </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
              <DataTemplate>
                  <Grid ColumnDefinitions="2*, 2*, 2*, 2*">
                      <TextBlock Text="{Binding Id}" TextAlignment="Center"  Grid.Column="0" Margin="5"/>
                      <TextBlock Text="{Binding Model}" TextAlignment="Center"  Grid.Column="1" Margin="5"/>
                      <TextBlock Text="{Binding Category}" TextAlignment="Center"  Grid.Column="2" Margin="5"/>
                      <TextBlock Text="{Binding Price}" TextAlignment="Center"  Grid.Column="3" Margin="5"/>
                  </Grid>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding IsPaginationVisible}" HorizontalAlignment="Center" Orientation="Horizontal" Margin="10">
        <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
          <Button.Opacity>
              <Binding Path="PreviousPageOpacity" />
          </Button.Opacity>
          <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="10"/>
        </Button>

        <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
          <Button.Opacity>
              <Binding Path="NextPageOpacity" />
          </Button.Opacity>
          <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="10"/>
        </Button>
      </StackPanel>

      <StackPanel Margin="20" HorizontalAlignment="Center">
        <!-- Bottone per prenotare l'auto -->
        <Button Content="Prenota auto" HorizontalAlignment="Center" Command="{Binding AddBookingCommand}" Margin="10, 20"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="10"/>


        <StackPanel IsVisible="{Binding IsBookingSummaryVisible}" Margin="20">
          <TextBlock Text="Resoconto Prenotazione" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding Booking.vehicle_model, StringFormat='Veicolo: {0}'}" />
          <TextBlock Text="{Binding Booking.start_date, StringFormat='Data inizio: {0:yyyy-MM-dd}'}" />
          <TextBlock Text="{Binding Booking.end_date, StringFormat='Data fine: {0:yyyy-MM-dd}'}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
