<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Frontend.ViewModels"
             x:DataType="vm:MyBookingsViewModel"
             xmlns:converters="clr-namespace:Frontend.Converters"
             x:Class="Frontend.Views.MyBookingsView">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="700">
        <TextBlock Text="Le Mie Prenotazioni" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Cerca per modello" Command="{Binding SearchItemsCommand}" CommandParameter="text" Margin="10"/>
            <Button Content="Cerca per prenotazione" Command="{Binding SearchItemsCommand}" CommandParameter="booking" Margin="10"/>
            <Button Content="Mostra tutte" Command="{Binding SearchItemsCommand}" CommandParameter="all" Margin="10"/>
        </StackPanel>

        <!-- Intestazione delle colonne -->
        <Grid ColumnDefinitions="2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="600">
            <TextBlock Text="Veicolo" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Inizio" Grid.Column="1"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Fine" Grid.Column="2"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Creazione" Grid.Column="3"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
        </Grid>

        <!-- Lista delle prenotazioni -->
        <ListBox ItemsSource="{Binding PaginatedBookings}" Width="600">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*, 2*, 2*, 2*" Margin="10">
                        <TextBlock Text="{Binding vehicle_model}" TextAlignment="Center"  Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{Binding start_date, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center"  Grid.Column="1" Margin="5"/>
                        <TextBlock Text="{Binding end_date, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center" Grid.Column="2" Margin="5"/>
                        <TextBlock Text="{Binding created_at, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center"  Grid.Column="3" Margin="5"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Paginazione -->
        <StackPanel IsVisible="{Binding IsPaginationVisible}" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
                <Button.Opacity>
                    <Binding Path="PreviousPageOpacity" />
                </Button.Opacity>
                <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
            </Button>

            <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
                <Button.Opacity>
                    <Binding Path="NextPageOpacity" />
                </Button.Opacity>
                <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
