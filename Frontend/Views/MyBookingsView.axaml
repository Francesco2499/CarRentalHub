<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Frontend.ViewModels"
             x:DataType="vm:MyBookingsViewModel"
             xmlns:converters="clr-namespace:Frontend.Converters"
             x:Class="Frontend.Views.MyBookingsView">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Le Mie Prenotazioni" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="Utilizza la funzione di ricerca per trovare facilmente le tue prenotazioni. Puoi filtrare per modello di auto per individuare rapidamente un veicolo specifico, oppure selezionare un intervallo di date per visualizzare tutte le prenotazioni effettuate nel periodo selezionato per verificarne il resoconto." 
                Width="750" 
                FontSize="16"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                TextAlignment="Justify" 
                Margin="0,0,0,10"/>

        <TextBlock Text="{Binding BookingMessage}" IsVisible="{Binding BookingMessage, Converter={StaticResource VisibilityConverter}}" FontSize="20" TextAlignment="Center"/>

        <StackPanel IsVisible="{Binding IsVisibleList}" HorizontalAlignment="Center">

            <StackPanel HorizontalAlignment="Center" Margin="20, 0, 20, 10" Width="450" Orientation="Horizontal">
                <TextBox Watermark="Cerca per modello..."  Height="10" Width="350" Margin="20" HorizontalAlignment="Center" Text="{Binding SearchQuery}" />
                <Button Content="Cerca" Command="{Binding SearchItemsCommand}" CommandParameter="text" Margin="5"/>
            </StackPanel>
            

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="450" Margin="20, 0, 20, 10">
                <CalendarDatePicker SelectedDate="{Binding StartDate}" Width="150" Margin="5"/>
                <CalendarDatePicker SelectedDate="{Binding EndDate}" Width="150" Margin="15, 5, 5, 5"/>
                <Button Content="Cerca per date" Command="{Binding SearchByDateCommand}" Margin="20"/>
            </StackPanel>

            <Button Content="Mostra tutte" IsEnabled="{Binding EnableShowAll}" Command="{Binding SearchItemsCommand}" HorizontalAlignment="Center" CommandParameter="all" Margin="5"/>

            <Grid ColumnDefinitions="3*, 2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="800">
                <TextBlock Text="Veicolo" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Prezzo" Grid.Column="1" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Inizio" Grid.Column="2"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Fine" Grid.Column="3"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Creazione" Grid.Column="4"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
            </Grid>

            <ListBox ItemsSource="{Binding Items}" Width="800">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="3*, 2*, 2*, 2*, 2*" Margin="10">
                            <TextBlock Text="{Binding VehicleModel}" TextAlignment="Center"  Grid.Column="0" Margin="5"/>
                            <TextBlock Text="{Binding TotalPrice}" TextAlignment="Center"  Grid.Column="1" Margin="5"/>
                            <TextBlock Text="{Binding StartDate, StringFormat=' {0:dd-MM-yyyy}'}" TextAlignment="Center"  Grid.Column="2" Margin="5"/>
                            <TextBlock Text="{Binding EndDate, StringFormat=' {0:dd-MM-yyyy}'}" TextAlignment="Center" Grid.Column="3" Margin="5"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat=' {0:dd-MM-yyyy}'}" TextAlignment="Center"  Grid.Column="4" Margin="5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsPaginationVisible}" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
                    <Button.Opacity>
                        <Binding Path="PreviousPageOpacity" />
                    </Button.Opacity>
                    <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}"  Height="10" Width="8"/>
                </Button>

                <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
                    <Button.Opacity>
                        <Binding Path="NextPageOpacity" />
                    </Button.Opacity>
                    <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}"  Height="10" Width="8"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource VisibilityConverter}}" HorizontalAlignment="Center" Foreground="Red" Margin="10"/>       
        </StackPanel>
    </StackPanel>
</UserControl>
