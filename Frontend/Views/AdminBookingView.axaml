<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Frontend.ViewModels"
             xmlns:converters="clr-namespace:Frontend.Converters"
             x:Class="Frontend.Views.AdminBookingView"
             x:DataType="vm:AdminBookingViewModel">
             
   <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock Text="Gestione Prenotazioni" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Text="Qui puoi cercare, modificare o eliminare le prenotazioni esistenti." TextAlignment="Center" Margin="0,0,0,10"/>

        <TextBox Text="{Binding SearchQuery}" Watermark="Cerca per cliente o veicolo..." Width="300" Margin="10"/>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Cerca per modello" Command="{Binding SearchItemsCommand}" CommandParameter="text" Margin="10"/>
            <Button Content="Cerca per utente" Command="{Binding SearchItemsCommand}" CommandParameter="user" Margin="10"/>
            <Button Content="Cerca per prenotazione" Command="{Binding SearchItemsCommand}" CommandParameter="booking" Margin="10"/>
            <Button Content="Mostra tutte" Command="{Binding SearchItemsCommand}" CommandParameter="all" Margin="10"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsGridVisible}">

          <Grid ColumnDefinitions="2*, 2*, 2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="900">
              <TextBlock Text="ID" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
              <TextBlock Text="ID User" Grid.Column="1" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
              <TextBlock Text="Nome Veicolo" Grid.Column="2" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
              <TextBlock Text="Giorno prenotazione" Grid.Column="3" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
              <TextBlock Text="Inizio" Grid.Column="4" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
              <TextBlock Text="Fine" Grid.Column="5" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
          </Grid>

          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedBooking, Mode=TwoWay}" Width="900">
              <ListBox.ItemTemplate>
                  <DataTemplate>
                      <Grid ColumnDefinitions="2*, 2*, 2*, 2*, 2*, 2*" Margin="10">
                          <TextBlock Text="{Binding Id}" TextAlignment="Center" Grid.Column="0" Margin="5"/>
                          <TextBlock Text="{Binding user_id}" TextAlignment="Center" Grid.Column="1" Margin="5"/>
                          <TextBlock Text="{Binding vehicle_model}" TextAlignment="Center" Grid.Column="2" Margin="5"/>
                          <TextBlock Text="{Binding created_at, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center" Grid.Column="3" Margin="5"/>
                          <TextBlock Text="{Binding start_date, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center" Grid.Column="4" Margin="5"/>
                          <TextBlock Text="{Binding end_date, StringFormat=' {0:yyyy-MM-dd}'}" TextAlignment="Center" Grid.Column="5" Margin="5"/>
                      </Grid>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding IsPaginationVisible}" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
              <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
                  <Button.Opacity>
                      <Binding Path="PreviousPageOpacity" />
                  </Button.Opacity>
                  <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
              </Button>

              <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
                  <Button.Opacity>
                      <Binding Path="NextPageOpacity" />
                  </Button.Opacity>
                  <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
              </Button>
          </StackPanel>
        </StackPanel>

        <!-- Form per Modifica -->
        <StackPanel IsVisible="{Binding IsFormVisible}" HorizontalAlignment="Center"  Margin="5" Background="#1e1e1e" Width="600">
            <TextBlock Margin="10,0,0,0" Text="User ID" />
            <TextBox Text="{Binding EditingBooking.user_id}" />

            <TextBlock Text="Veicolo" />
            <TextBox Text="{Binding EditingBooking.vehicle_id}" />

            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="5">
                    <TextBlock Text="Data Inizio" />
                    <CalendarDatePicker SelectedDate="{Binding EditingBooking.start_date, StringFormat=' {0:yyyy-MM-dd}'}" />
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Data Fine" />
                    <CalendarDatePicker SelectedDate="{Binding EditingBooking.end_date, StringFormat=' {0:yyyy-MM-dd}'}" />
                </StackPanel>
            </StackPanel>

            <Button Content="Salva Modifica" Command="{Binding SaveBookingCommand}" Margin="5"/>
        </StackPanel>

        
        <StackPanel Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Modifica Prenotazione" Command="{Binding ShowEditBookingFormCommand}" Margin="5"/>
            <Button Content="Elimina Prenotazione" Command="{Binding DeleteBookingCommand}" Margin="5"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="10"/>
  </StackPanel>

</UserControl>
