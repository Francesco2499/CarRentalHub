<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Frontend.ViewModels"
             xmlns:converters="clr-namespace:Frontend.Converters"
             xmlns:models="clr-namespace:Frontend.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:AdminVehicleViewModel"
             x:Class="Frontend.Views.AdminVehicleView">
             
   <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Gestione Veicoli" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>

        <StackPanel IsVisible="{Binding IsVisibleList}">
            <TextBox Text="{Binding SearchQuery}" 
                        Watermark="Cerca per modello o marca..." Width="300" Margin="10"/>
            <Button HorizontalAlignment="Center" Content="Cerca" Command="{Binding SearchItemsCommand}" CommandParameter="text" Margin="10"/>
            <Grid ColumnDefinitions="2*, 2*, 2*, 2*, 2*" Background="#1e1e1e" Margin="10" Width="600">
                <TextBlock Text="ID" Grid.Column="0" TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Modello" Grid.Column="1"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Categoria" Grid.Column="2"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Prezzo" Grid.Column="3"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Comune" Grid.Column="4"  TextAlignment="Center" FontWeight="Bold" Margin="5"/>
            </Grid>

            <!-- Lista delle prenotazioni -->
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"  Width="600">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="2*, 2*, 2*, 2*, 2*" Margin="10">
                            <TextBlock Text="{Binding Id}" TextAlignment="Center" Grid.Column="0" Margin="5"/>
                            <TextBlock Text="{Binding Model}" TextAlignment="Center" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="{Binding Category}" TextAlignment="Center" Grid.Column="2" Margin="5"/>
                            <TextBlock Text="{Binding Price}" TextAlignment="Center" Grid.Column="3" Margin="5"/>
                            <TextBlock Text="{Binding Location}" TextAlignment="Center" Grid.Column="4" Margin="5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Paginazione -->
            <StackPanel IsVisible="{Binding IsPaginationVisible}" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Command="{Binding GoToPreviousPageCommand}" Margin="5" IsEnabled="{Binding IsPreviousPageEnabled}">
                    <Button.Opacity>
                        <Binding Path="PreviousPageOpacity" />
                    </Button.Opacity>
                    <PathIcon Data="{Binding Source=chevron_left_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
                </Button>

                <Button Command="{Binding GoToNextPageCommand}" Margin="5" IsEnabled="{Binding IsNextPageEnabled}">
                    <Button.Opacity>
                        <Binding Path="NextPageOpacity" />
                    </Button.Opacity>
                    <PathIcon Data="{Binding Source=chevron_right_regular, Converter={x:Static converters:TypeConverters.IconConverter}}" Width="14"/>
                </Button>
            </StackPanel>

            <StackPanel Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Content="Aggiungi Veicolo" Command="{Binding ShowAddVehicleFormCommand}" Margin="5"/>
                <Button Content="Modifica Veicolo" Command="{Binding ShowEditVehicleFormCommand}" Margin="5"/>
                <Button Content="Elimina Veicolo" Command="{Binding DeleteVehicleCommand}" Margin="5"/>
            </StackPanel>

        </StackPanel>

        <!-- Form per Aggiunta/Modifica -->
        <Border Background="#252525" IsVisible="{Binding IsFormVisible}" 
            CornerRadius="10" Padding="20" Width="450" 
            HorizontalAlignment="Center" BorderBrush="#444" BorderThickness="2">

            <StackPanel Margin="5" Width="400">
                
                <TextBlock Text="Modello" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                <TextBox Text="{Binding EditingVehicle.Model}" Margin="0, 0, 0, 15"
                        Background="#333" Foreground="White" BorderBrush="#555" 
                        CornerRadius="6" Padding="5"/>

                <TextBlock Text="Categoria" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                <TextBox Text="{Binding EditingVehicle.Category}" Margin="0, 0, 0, 15"
                        Background="#333" Foreground="White" BorderBrush="#555" Padding="5"/>

                <TextBlock Text="Prezzo" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                <TextBox Text="{Binding EditingVehicle.Price}" Margin="0, 0, 0, 15"
                        Background="#333" Foreground="White" BorderBrush="#555" Padding="5"/>

                <TextBlock Text="Comune" FontWeight="Bold" Foreground="White" Margin="0,5"/>
                <TextBox Text="{Binding EditingVehicle.Location}" Margin="0, 0, 0, 20"
                        Background="#333" Foreground="White" BorderBrush="#555" Padding="5"/>

                <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <Button Content="Salva" HorizontalAlignment="Center" Command="{Binding SaveVehicleCommand}" Margin="5"/>

                    <Button Content="Torna indietro" HorizontalAlignment="Center" Command="{Binding GoBackCommand}" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" Foreground="Red" Margin="10"/>
    </StackPanel>
</UserControl>
